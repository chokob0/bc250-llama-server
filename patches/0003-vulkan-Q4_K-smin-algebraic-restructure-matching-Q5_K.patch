Subject: [PATCH 3/4] =?UTF-8?q?vulkan:=20Q4=5FK=20smin=20=E2=80=94=20algeb?=
 =?UTF-8?q?raic=20restructure=20matching=20Q5=5FK?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Rewrites the Q4_K min-correction (smin) from 16 chained FMAs with
repeated sub-scales into 4 horizontal sums and 4 FMAs:

  smin = Sum(by10.i) * sc2 + Sum(by132.i) * sc3 + Sum(by20.i) * sc6 + Sum(by232.i) * sc7

This is algebraically identical. It matches the form already used in
mul_mat_vec_q5_k.comp — Q4_K apparently just missed the same cleanup.
The compiler emits horizontal-sum friendly code via dot(v, vec4(1.0)),
and the shorter dependency chain schedules better.

Measured on BC-250 (gfx1013 RADV): +3% tg across Q4_K workloads.
Perplexity unchanged on Qwen3-4B Q4_K (1.0455 ±0.0246 either way).

This is the fork's cleanest candidate for upstream PR — narrow scope,
no arch-specific assumptions, matches existing Q5_K style.

(cherry picked from commit 7ea35f6005d6cd06017573c4e2ba6bd9d92c2e86)
(cherry picked from commit 5ff86b0f8a798fcb22e0e98b06fae6c5c453b679)
---
 .../ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k.comp  | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k.comp
index 93fbacc62..a3f9ebe0e 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k.comp
@@ -74,11 +74,12 @@ void calc_superblock(const uint a_offset, const uint b_offset, const uint v_im,
             const FLOAT_TYPE sy = fma(FLOAT_TYPE(by132.x),     q4_4,  fma(FLOAT_TYPE(by132.y), q4_5,  fma(FLOAT_TYPE(by132.z), q4_6,  FLOAT_TYPE(by132.w) * q4_7)));
             const FLOAT_TYPE sz = fma(FLOAT_TYPE(by20.x),      q4_8,  fma(FLOAT_TYPE(by20.y),  q4_9,  fma(FLOAT_TYPE(by20.z),  q4_10, FLOAT_TYPE(by20.w) *  q4_11)));
             const FLOAT_TYPE sw = fma(FLOAT_TYPE(by232.x),     q4_12, fma(FLOAT_TYPE(by232.y), q4_13, fma(FLOAT_TYPE(by232.z), q4_14, FLOAT_TYPE(by232.w) * q4_15)));
-            const FLOAT_TYPE smin =
-                fma(FLOAT_TYPE(by10.x), sc2, fma(FLOAT_TYPE(by132.x), sc3, fma(FLOAT_TYPE(by20.x), sc6, fma(FLOAT_TYPE(by232.x), sc7,
-                fma(FLOAT_TYPE(by10.y), sc2, fma(FLOAT_TYPE(by132.y), sc3, fma(FLOAT_TYPE(by20.y), sc6, fma(FLOAT_TYPE(by232.y), sc7,
-                fma(FLOAT_TYPE(by10.z), sc2, fma(FLOAT_TYPE(by132.z), sc3, fma(FLOAT_TYPE(by20.z), sc6, fma(FLOAT_TYPE(by232.z), sc7,
-                fma(FLOAT_TYPE(by10.w), sc2, fma(FLOAT_TYPE(by132.w), sc3, fma(FLOAT_TYPE(by20.w), sc6,     FLOAT_TYPE(by232.w) * sc7)))))))))))))));
+            const vec4 ones4 = vec4(1.0);
+            const FLOAT_TYPE s_by10  = FLOAT_TYPE(dot(by10,  ones4));
+            const FLOAT_TYPE s_by132 = FLOAT_TYPE(dot(by132, ones4));
+            const FLOAT_TYPE s_by20  = FLOAT_TYPE(dot(by20,  ones4));
+            const FLOAT_TYPE s_by232 = FLOAT_TYPE(dot(by232, ones4));
+            const FLOAT_TYPE smin = fma(s_by10, sc2, fma(s_by132, sc3, fma(s_by20, sc6, s_by232 * sc7)));
             temp[j][n] = fma(dm.x, fma(sx, sc0, fma(sy, sc1, fma(sz, sc4, sw * sc5))), fma(-dm.y, smin, temp[j][n]));
         }
     }
