From 77fbdae987874382a995445c2c08ad96d2dd464b Mon Sep 17 00:00:00 2001
From: chokob0 <services@jworks.es>
Date: Mon, 16 Nov 2026 22:32:17 +0100
Subject: [PATCH 1/4] vulkan: use 4 rows per workgroup for K-quant mat-vec on
 RDNA1

---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index b5b4264fb..501ca9749 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -3230,6 +3230,11 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         return is_rdna3_or_4 ? 4u : rows;
     };
     uint32_t rm_iq = 2 * rm_kq;
+    // RDNA1: K-quant mat-vec runs faster with 4 rows per workgroup, as on GCN. rm_iq is
+    // derived from the default above and kept at 4, since 8 measured slightly slower.
+    if (device->vendor_id == VK_VENDOR_ID_AMD && device->architecture == AMD_RDNA1) {
+        rm_kq = 4;
+    }
 
     const bool use_subgroups = device->subgroup_arithmetic;
     // The Imagination proprietary compiler rejects the subgroup-only dequant mul_mat_vec
-- 
