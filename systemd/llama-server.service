# /etc/systemd/system/llama-server.service
# llama-server in router mode on an AMD BC-250. Replaces ollama.service:
# both cannot run at the same time, they share the same 16 GB.
[Unit]
Description=llama-server (llama.cpp + bc250 patches, Vulkan)
After=network-online.target cyan-skillfish-governor-smu.service
Wants=network-online.target
Conflicts=ollama.service

[Service]
Type=simple
User=llama
Group=llama
SupplementaryGroups=video render
WorkingDirectory=/opt/llama.cpp
# No --sleep-idle-seconds: the model marked load-on-startup stays resident, so the
# first answer after a quiet night takes ~1 s instead of a ~20 s reload.
ExecStart=/opt/llama.cpp/build/bin/llama-server \
    --models-preset /etc/llama/models.ini \
    --models-max 1 \
    --host 0.0.0.0 --port 8080 \
    --metrics
# API key: LLAMA_API_KEY=... (install.sh creates it)
EnvironmentFile=-/etc/llama/env
Restart=on-failure
RestartSec=5
OOMScoreAdjust=-1000
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
